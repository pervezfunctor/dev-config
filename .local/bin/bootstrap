#!/usr/bin/env bash

set -euo pipefail

setup_colors() {
  if [[ -t 1 ]]; then
    BOLD='\033[1m'
    GREEN='\033[0;32m'
    YELLOW='\033[0;33m'
    RED='\033[0;31m'
    NC='\033[0m'
  else
    BOLD=''
    GREEN=''
    YELLOW=''
    RED=''
    NC=''
  fi
}

info() { printf "${BOLD}${GREEN}[INFO]${NC}  %s\n" "$*"; }
warn() { printf "${BOLD}${YELLOW}[WARN]${NC}  %s\n" "$*"; }
error() { printf "${BOLD}${RED}[ERROR]${NC} %s\n" "$*" >&2; }
die() {
  error "$*"
  exit 1
}

has_cmd() {
  command -v "$1" &>/dev/null
}

detect_os() {
  if has_cmd apt; then
    OS="ubuntu"
  elif has_cmd dnf; then
    OS="fedora"
  elif has_cmd pacman; then
    OS="arch"
  elif has_cmd zypper; then
    OS="tw"
  else
    die "Unsupported OS — only Debian/Ubuntu, Fedora, Tumbleweed, and Arch are supported."
  fi
  info "Detected OS: ${OS}"
}

install_packages() {
  info "Installing OS packages…"

  local -a pkgs=(
    curl git wget trash-cli tar unzip zip fish rsync
    clang cmake entr gcc make fzf eza zoxide bat
    ripgrep tealdeer direnv jq flatpak ptyxis
  )

  case "${OS}" in
  ubuntu)
    sudo apt update && sudo apt upgrade -y
    sudo apt install -y build-essential pkg-config clang-tools ninja-build "${pkgs[@]}"
    ;;
  fedora)
    sudo dnf update --refresh -y
    sudo dnf install -y pkg-config g++ clang-tools-extra ninja-build g++ "${pkgs[@]}"
    ;;
  arch)
    sudo pacman -Syu --noconfirm
    sudo pacman -S --noconfirm ninja pkgconf base-devel "${pkgs[@]}"
    ;;
  tw)
    sudo zypper refresh
    sudo zypper install -y ninja pkg-config gcc-c++ "${pkgs[@]}"
    ;;
  esac
}

set_fish_default() {
  local fish_path
  fish_path="$(command -v fish)"
  local current_shell
  current_shell="$(grep "^${USER}:" /etc/passwd 2>/dev/null | cut -d: -f7 || true)"
  if [[ "${current_shell}" == "${fish_path}" ]]; then
    info "fish is already the default shell."
    return 0
  fi

  info "Setting fish as the default shell…"
  sudo chsh -s "${fish_path}" "${USER}"
  warn "Log out and back in (or reboot) for the change to take effect."
}

install_uv() {
  if has_cmd uv; then
    info "uv already installed, skipping."
    return 0
  fi

  info "Installing uv (Python package manager)…"
  curl -LsSf https://astral.sh/uv/install.sh | sh
  uv tool install pipx
}

install_homebrew() {
  if has_cmd brew; then
    info "Homebrew already installed, skipping."
    return 0
  fi

  info "Installing Homebrew…"
  /bin/bash -c "$(curl -fsSL https://raw.githubusercontent.com/Homebrew/install/HEAD/install.sh)"
}

is_desktop() {
  [ -n "${XDG_CURRENT_DESKTOP}" ] || [ -n "${DISPLAY}" ] || [ -n "${WAYLAND_DISPLAY}" ]
}

install_brew_packages() {
  info "Installing packages via Homebrew…"
  brew install starship gh fd carapace
}

install_zed() {
  if has_cmd zed || has_cmd zed-editor; then
    info "Zed editor already installed, skipping."
    return 0
  fi

  info "Installing Zed editor…"
  curl -f https://zed.dev/install.sh | sh
}

sync_dotfiles() {
  if ! has_cmd rsync; then
    die "rsync is not installed."
  fi

  local repo_dir="${HOME}/.dev-config"
  local src_dir="${repo_dir}/.config"
  local dest_dir="${HOME}/.config"
  local backup_dir
  backup_dir="${HOME}/.dotfiles-backup/$(date +%Y%m%d-%H%M%S)"

  if [[ ! -d "${src_dir}" ]]; then
    git clone https://github.com/pervezfunctor/dev-config.git "${repo_dir}" || {
      die "Failed to clone dev-config repository."
    }
  fi

  mkdir -p "${dest_dir}"

  info "Syncing dotfiles to ${dest_dir}…"
  rsync -av --backup --backup-dir="${backup_dir}" "${src_dir}/" "${dest_dir}/"

  if [[ -d "${backup_dir}" ]]; then
    info "Backup of existing files saved to ${backup_dir}"
  else
    info "No existing files needed backup."
  fi
}

install_docker() {
  if has_cmd docker; then
    info "Docker already installed, skipping."
    return 0
  fi

  if [ "${OS}" = "arch" ] || [ "${OS}" = "tw" ]; then
    sudo pacman -S docker docker-compose
  else
    info "Installing Docker via official script…"
    curl -fsSL https://get.docker.com | sh
  fi
  info "Adding ${USER} to the docker group…"
  sudo usermod -aG docker "${USER}"
  warn "Log out and back in (or reboot) for docker group to take effect."
}

main() {
  is_desktop || die "Not a desktop environment"

  export PATH="$HOME/.local/bin:/home/linuxbrew/.linuxbrew/bin:${PATH}"

  setup_colors
  detect_os

  info "Starting setup…"
  echo ""

  install_packages
  install_docker
  set_fish_default

  install_homebrew
  install_brew_packages

  install_uv

  install_zed
  gnome-setup jetbrains-mono
  gnome-setup ptyxis

  echo ""
  info "All done! Restart your terminal to enjoy your new environment."
}

main "$@"
